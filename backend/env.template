# Hugging Face Configuration
HUGGINGFACE_API_KEY=YOUR_API_KEY
# Indian Law Specific Models
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Provider chain for llm_utils.invoke_llm: comma-separated provider:model, tried in order
# Each purpose has its own chain so a burst of users spreads over several rate limits.
# Groq's free tier allows ~8,000 tokens/minute per model: one full answer a minute.
LLM_CHAIN=groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,openrouter:nvidia/nemotron-3.5-super-vl:free,dahl:deepseek-ai/DeepSeek-V4-Flash-0731
LLM_CHAIN_ANALYZE=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,dahl:deepseek-ai/DeepSeek-V4-Flash-0731
LLM_CHAIN_FAST=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,dahl:deepseek-ai/DeepSeek-V4-Flash-0731
LLM_CHAIN_REVIEW=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,dahl:deepseek-ai/DeepSeek-V4-Flash-0731
ANSWER_REVIEW=true
# Family-law intake: follow-up questions for a personal case
FAMILY_MIN_QUESTIONS=5
FAMILY_MAX_QUESTIONS=8
# JWT_SECRET_KEY must be set to a long random value; if empty a random one is used per run
JWT_SECRET_KEY=
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEYS=key1,key2
DAHL_API_KEY=your_dahl_key

# The embedding model, its vector size, its query prefix and the Milvus collection
# must match: a collection only works with the model it was built with.
#   BAAI/bge-small-en-v1.5   384   indian_family_law_cases_bge_small   (prefix below)
#   bhavyagiri/InLegal-Sbert 768   indian_family_law_cases_hrag_test   (no prefix)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# Query translation (any language -> English, retrieval only; query/root_query
# in state stay untranslated for analysis and answer generation)
TRANSLATION_MODEL=google/gemma-3-4b-it
ENABLE_QUERY_TRANSLATION=true
# Optional comma-separated ISO 639-1 allowlist; empty = all non-English queries.
TRANSLATION_ENABLED_LANGUAGES=
# Inference providers tried in order for the translation model ("auto" = Hugging Face picks).
TRANSLATION_PROVIDERS=auto

# Citation guard: strict | mixed | flag (see citation_guard.py)
CITATION_GUARD_MODE=mixed

# Retrieval
# Merge BM25 keyword ranking with vector search (runs in-process, no API calls).
ENABLE_HYBRID_SEARCH=true
# Skip off-topic documents and return one document per subject (corpus_curation.py).
ENABLE_CORPUS_CURATION=true
# Rewrite each question into a short search query (one extra model call per English question).
ENABLE_QUERY_REWRITE=false

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=indian_family_law_cases_bge_small
MILVUS_URI=https://YOUR-MILVUS-HOST
MILVUS_TOKEN=YOUR_MILVUS_TOKEN
# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# Application Configuration
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# # LangSmith (Optional - for debugging)
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=family-law-assistant

# Feature Flags
ENABLE_STREAMING=true
ENABLE_MULTI_TURN=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ASR (Speech-to-Text) Configuration
ENABLE_ASR=false
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_DEFAULT_LANGUAGE=
ASR_MAX_AUDIO_SECONDS=60
ASR_RATE_LIMIT_PER_MINUTE=20

# IndicParler-TTS English speaker (recommended: Mary or Thoma)
TTS_ENGLISH_SPEAKER=Mary

# Logging
LOG_LEVEL=INFO

# CPU fallback when the primary TTS Space fails (including ZeroGPU quota).
TTS_FALLBACK_SPACE_URL=rverma0631/TTS_Sanskrit
