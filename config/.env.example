# Copy this file to config/.env and fill with real values.
# Never commit real credentials.

# TokenRouter (PRIMARY brain - GLM-5.3 reasoning model, replaces Llama)
# Get key: https://tokenrouter.com
tokenrouter_api=
TOKENROUTER_MODEL=z-ai/glm-5.3-free

# NVIDIA API Keys
nvidia_api=
nvidia_api_2=

# Cerebras API
cerebras_api=

# Groq API
groq_api=

# OpenRouter API keys (optional extra provider pool)
openrouter_api=
openrouter_api_2=
openrouter_api_3=
openrouter_api_4=
OPENROUTER_HTTP_REFERER=https://lawgpt-backend2024.azurewebsites.net
OPENROUTER_APP_TITLE=LAW-GPT Court Debate
COURT_DEBATE_ISSUE_BLUEPRINT_LLM_TIMEOUT_SECONDS=8

# Web Search APIs (optional)
BRAVE_API_KEY=
SERPER_API_KEY=

# Indian Kanoon API token
INDIAN_KANOON_API_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend auth secret
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=12

# Persist auth users on Azure App Service storage instead of the packaged app root.
AUTH_USER_DB_PATH=/home/data/auth_users.json

# CodeCraft gateway - clarification gap-analysis model. The clarification engine asks
# this model to read the user's own scenario and derive its specific data gaps, instead
# of replaying a canned question plan. Without a key the engine falls back to the
# deterministic keyword planner, so this is safe to leave blank.
codecraft_api=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
CODECRAFT_MODEL=deepseek-v4-flash-0731
# Optional override for the gap-analysis call only.
CLARIFICATION_GAP_MODEL=
# Gap-analysis budget. The model reasons before answering, so the token ceiling must
# leave room for the visible JSON, and the timeout must fit the 240s request window.
CLARIFICATION_GAP_ENABLED=true
CLARIFICATION_GAP_TIMEOUT_SECONDS=60
CLARIFICATION_GAP_MAX_TOKENS=4000
CLARIFICATION_GAP_REASONING_EFFORT=minimal

# ============================================================================
# SINGLE LLM PROVIDER (default) — Dahl only, one model, no rotation
# ============================================================================
# Measured live against inference.dahl.global with the 100M free-token
# allowance: 12/12 calls succeeded on both keys, p50 0.82 s, no 429s, no
# rate-limit headers. A second provider adds latency and failover complexity
# for no reliability gain, so the pool is Dahl-only by default.
#
# dahl_api=
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# !! LEAVE EMPTY for DeepSeek-V4-Flash - measured 2026-10-05 on the live
# endpoint. Sending ANY explicit reasoning_effort turns the hidden reasoning
# trace ON and makes the model BOTH slower and shorter:
#   (nothing) ->   0-192 rsn,  0.5-8.9s, 1199 chars   <-- USE THIS
#   low       -> 970 rsn, 14.5s,  222 chars
#   minimal   -> 448 rsn,  8.3s, 2435 chars
#   none      ->   0 rsn, 45.5s, 3543 chars
# This model returns real content at EVERY budget tested, down to max_tokens=3,
# so no token floor is applied.
#
# A DIFFERENT model may need a value: zai-org/GLM-5.3-Flash is the opposite -
# it returns EMPTY content unless reasoning_effort is set.
#DAHL_REASONING_EFFORT=

# One provider, one model, no rotation. Set false to restore the multi-vendor
# failover pool (TokenRouter / Groq / Cerebras / OpenRouter / NVIDIA).
#LLM_SINGLE_PROVIDER=true

# ============================================================================
# G9 - cold start safety (A6)
# ============================================================================
# Best practice on Azure App Service: let Oryx build requirements.txt into the
# build-time venv and set INSTALL_RUNTIME_DEPS=false. The startup.sh block is
# now guarded, so a failed index no longer aborts the boot, but false still
# removes the network dependency from every cold start.
#INSTALL_RUNTIME_DEPS=false
#PIP_INSTALL_ATTEMPTS=3
#PIP_TIMEOUT_SECONDS=20
# Probe whether fastapi/uvicorn/gunicorn/openai/pydantic already import and
# skip the network install when they do.
#SKIP_DEPS_IF_IMPORTABLE=true

# ============================================================================
# G10 - retrieval policy (A6)
# ============================================================================
# MEASURED: STRICT_RETRIEVAL_REQUIRED gates BOOT ONLY. With it true and no
# retrieval backend, __init__ raises and EVERY route 503s (health included).
# Keep false. The per-answer refusal is REQUIRE_GROUNDED_ANSWERS, which is a
# separate flag and independently defaults to true.
#STRICT_RETRIEVAL_REQUIRED=false
#REQUIRE_GROUNDED_ANSWERS=true
